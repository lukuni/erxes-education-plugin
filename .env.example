NODE_ENV=development
# Overrides api.port from erxes.json.
# PORT=
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Required by the platform stack (tenant-scoped Mongoose models).
# MONGO_URL=mongodb://localhost:27017/erxes
# Where the browser loads the UI remote from. Unset = plugins.erxes.io/<release>/education_ui/.
UI_ENTRY_URL=http://localhost:3099/remoteEntry.js
# Address the gateway uses to reach this API. Unset = localhost (dev) or plugin-education-api (prod).
# LOAD_BALANCER_ADDRESS=
# Release folder on plugins.erxes.io when it starts with "3."; otherwise "latest".
# RELEASE_VERSION=

# Gemma 4 through the Gemini API (optional). Get a key at https://aistudio.google.com/apikey
# Without it the AI editor uses offline spelling rules and lesson generation is off.
# GEMINI_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it
# Chimege Mongolian text-to-speech for cards and dictation.
# Verify with: pnpm --filter education_api chimege:check
# CHIMEGE_TOKEN=
# Override if your account uses another endpoint (comma-separated candidates):
# CHIMEGE_TTS_URL=https://api.chimege.com/v1.2/synthesize
# CHIMEGE_SPEED=0.95
# Streak days roll over at midnight in this time zone.
# EDUCATION_TIMEZONE=Asia/Ulaanbaatar
